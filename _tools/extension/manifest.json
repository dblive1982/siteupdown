{
  "manifest_version": 3,
  "name": "siteupdown.com: Is this site down?",
  "short_name": "siteupdown",
  "version": "1.1.0",
  "description": "One click to see whether the site you are on is down for everyone or just you. Add sites to your watchlist for alerts.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Is this site down?",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "permissions": ["activeTab"],
  "host_permissions": ["https://siteupdown.com/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
