# siteupdown.com — Apache/LiteSpeed rules (Hostinger)
Options -Indexes
DirectoryIndex index.html

# Keep source, tools and secrets out of public view.
RedirectMatch 404 ^/(_tools|_src|\.git|\.github|README|DEPLOY)
RedirectMatch 404 ^/sud-config
RedirectMatch 404 ^/api/_

RewriteEngine On
# TEST-CLEAN-URLS
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([A-Za-z0-9_-]+)/?$ $1.html [L]
# Nothing on this site takes file uploads or multipart forms (everything is JSON), so refuse them early.
RewriteCond %{HTTP:Content-Type} multipart/ [NC]
RewriteRule ^ - [F,L]
# Always HTTPS; www.siteupdown.com goes to siteupdown.com.
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.siteupdown\.com$ [NC]
RewriteRule ^ https://siteupdown.com%{REQUEST_URI} [R=301,L]

# Share links: /s/abc123... shows a saved check on the home page.
RewriteRule ^s/([a-f0-9]{10})/?$ /index.html?r=$1 [L,QSA]

# Public status pages: /status/example.com
RewriteRule ^badge/([A-Za-z0-9.-]+)\.svg$ /api/badge.php?host=$1 [L,QSA]
RewriteRule ^widget/([A-Za-z0-9.-]+)/?$ /api/widget.php?host=$1 [L,QSA]
RewriteRule ^status/[A-Za-z0-9.-]+/?$ /status.html [L]

# Help centre: /help/ and /help/some-guide
RewriteRule ^help/([a-z0-9-]+)/?$ /help/$1.html [L]
RewriteRule ^tools/([a-z0-9-]+)/?$ /tools/$1.html [L]
RewriteCond %{THE_REQUEST} \s/+help/(?!index\.)([a-z0-9-]+)\.html[\s?]
RewriteRule ^help/(?!index\.)([a-z0-9-]+)\.html$ /help/$1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+tools/(?!index\.)([a-z0-9-]+)\.html[\s?]
RewriteRule ^tools/(?!index\.)([a-z0-9-]+)\.html$ /tools/$1 [R=301,L]

# "Is X down?" pages: /is-instagram-down and /is-it-down/
RewriteRule ^(?!is-it-down/?$)(is-[a-z0-9-]+-down)/?$ /$1.html [L]
RewriteCond %{THE_REQUEST} \s/+(is-[a-z0-9-]+-down)\.html[\s?]
RewriteRule ^(is-[a-z0-9-]+-down)\.html$ /$1 [R=301,L]

# Clean URLs.
# Old address: heat map is now the outage map
RewriteRule ^heat-map(\.html)?/?$ /outage-map [R=301,L]
RewriteRule ^(login|account|monitor|speed|internet-speed-test|what-is-my-ip|game-ping-test|outage-map|outage-history|about|privacy|legal|business|admin|contact)/?$ /$1.html [L]
RewriteCond %{THE_REQUEST} \s/+(login|account|monitor|speed|internet-speed-test|what-is-my-ip|game-ping-test|outage-map|outage-history|about|privacy|legal|business|admin|contact|index)\.html[\s?]
RewriteRule ^(login|account|monitor|speed|internet-speed-test|what-is-my-ip|game-ping-test|outage-map|outage-history|about|privacy|legal|business|admin|contact|index)\.html$ /$1 [R=301,L]
RewriteRule ^index$ / [R=301,L]

ErrorDocument 404 /404.html
ErrorDocument 403 /403.html
ErrorDocument 500 /500.html

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://accounts.google.com https://pagead2.googlesyndication.com https://partner.googleadservices.com https://tpc.googlesyndication.com https://www.googletagservices.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://accounts.google.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://speed.cloudflare.com https://*.amazonaws.com https://accounts.google.com https://pagead2.googlesyndication.com https://*.g.doubleclick.net https://ep1.adtrafficquality.google; frame-src 'self' https://accounts.google.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://*.safeframe.googlesyndication.com; base-uri 'self'; form-action 'self'; object-src 'none'"
  <FilesMatch "^widget\.php$">
    Header always unset X-Frame-Options
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
  Header always unset X-Powered-By
</IfModule>
